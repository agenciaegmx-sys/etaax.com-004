      "purpose": "any"
    },
    {
      "src": "icons/icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icono-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/app-movil/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
