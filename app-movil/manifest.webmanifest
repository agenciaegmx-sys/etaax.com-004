{
  "name": "ETAAX · Registro de barra y cocina",
  "short_name": "ETAAX Registro",
  "description": "Entradas, mermas, cortesías y conteo de existencias desde el teléfono.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#13120f",
